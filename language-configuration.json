{
	"comments": {
		"lineComment": "%",
		"blockComment": ["%{", "%}"]
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"]
	],
	"wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
	"indentationRules": {
		"increaseIndentPattern": "^(?!\\s*%)(?!.*[,;]\\s*(end\\w*|until)\\b)\\s*(if|elseif|else|for|parfor|while|switch|case|otherwise|do|try|catch|unwind_protect|unwind_protect_cleanup|function|classdef|methods|properties|events|enumeration)\\b",
		"decreaseIndentPattern": "^\\s*(end|endif|endfor|endparfor|endwhile|endswitch|end_try_catch|end_unwind_protect|endfunction|endclassdef|endmethods|endproperties|endevents|endenumeration|until|else|elseif|case|otherwise|catch|unwind_protect_cleanup)\\b"
	},
	"onEnterRules": [
		{
			"beforeText": "^(?!\\s*%).*\\.\\.\\.\\s*$",
			"action": { "indentAction": "indent" }
		}
	],
	"folding": {
		"markers": {
			"start": "^\\s*%\\s*#?region\\b",
			"end": "^\\s*%\\s*#?endregion\\b"
		}
	}
}
