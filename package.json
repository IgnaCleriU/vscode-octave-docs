{
	"name": "octave-docs",
	"displayName": "Octave Docs",
	"description": "Octave Hacking + documentación al pasar el mouse para funciones de Octave y de los paquetes control y symbolic",
	"publisher": "IgnaCleriU",
	"author": {
		"name": "IgnaCleriU"
	},
	"version": "0.7.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/IgnaCleriU/vscode-octave-docs"
	},
	"bugs": {
		"url": "https://github.com/IgnaCleriU/vscode-octave-docs/issues"
	},
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"icon": "images/octave-hacking-logo.png",
	"activationEvents": [
		"onLanguage:octave",
		"onCommand:octaveDocs.runFile",
		"onCommand:octaveDocs.runSelection",
		"onCommand:octaveDocs.runSection"
	],
	"main": "./out/main.js",
	"contributes": {
		"languages": [
			{
				"id": "octave",
				"aliases": [
					"Octave"
				],
				"extensions": [
					".m"
				],
				"filenames": [
					"PKG_ADD",
					"PKG_DEL"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./images/octave-file.svg",
					"dark": "./images/octave-file.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "octave",
				"scopeName": "source.octave",
				"path": "./syntaxes/Octave.tmLanguage"
			}
		],
		"snippets": [
			{
				"language": "octave",
				"path": "./snippets.json"
			},
			{
				"language": "octave",
				"path": "./snippets-control.json"
			}
		],
		"commands": [
			{
				"command": "octaveDocs.runFile",
				"title": "Run File",
				"category": "Octave",
				"icon": "$(play)"
			},
			{
				"command": "octaveDocs.runSelection",
				"title": "Run Selection or Line",
				"category": "Octave"
			},
			{
				"command": "octaveDocs.runSection",
				"title": "Run Section",
				"category": "Octave"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "octaveDocs.runFile",
					"when": "editorLangId == octave",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "octaveDocs.runFile",
					"when": "editorLangId == octave",
					"group": "Octave@1"
				},
				{
					"command": "octaveDocs.runSelection",
					"when": "editorLangId == octave",
					"group": "Octave@2"
				},
				{
					"command": "octaveDocs.runSection",
					"when": "editorLangId == octave",
					"group": "Octave@3"
				}
			]
		},
		"keybindings": [
			{
				"command": "octaveDocs.runFile",
				"key": "ctrl+shift+enter",
				"when": "editorTextFocus && editorLangId == octave"
			},
			{
				"command": "octaveDocs.runSelection",
				"key": "shift+enter",
				"when": "editorTextFocus && editorLangId == octave"
			},
			{
				"command": "octaveDocs.runSection",
				"key": "ctrl+enter",
				"when": "editorTextFocus && editorLangId == octave"
			},
			{
				"command": "editor.action.commentLine",
				"key": "ctrl+[Backslash]",
				"when": "editorTextFocus && editorLangId == octave && !editorReadonly"
			}
		],
		"configuration": {
			"title": "Octave Docs",
			"properties": {
				"octaveDocs.octavePath": {
					"type": "string",
					"default": "octave",
					"description": "Octave executable used to run code and to check syntax."
				},
				"octaveDocs.run.codeLens": {
					"type": "boolean",
					"default": true,
					"description": "Show a \"Run section\" CodeLens on each %% cell delimiter."
				},
				"octaveDocs.diagnostics.syntax": {
					"type": "boolean",
					"default": true,
					"description": "Report Octave syntax errors when a .m file is opened or saved. The code is parsed, not executed."
				},
				"octaveDocs.diagnostics.pkgLoad": {
					"type": "boolean",
					"default": true,
					"description": "Warn when a control or symbolic function is used in a file that does not load its package (pkg load)."
				}
			}
		},
		"configurationDefaults": {
			"[octave]": {
				"editor.semanticHighlighting.enabled": true
			}
		}
	},
	"scripts": {
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
		"vscode:prepublish": "npm run esbuild-base -- --minify",
		"build": "npm run esbuild-base -- --sourcemap",
		"build-watch": "npm run esbuild-base -- --sourcemap --watch",
		"fmt": "prettier --write \"src/**/*.ts\"&& npm run test -- --fix",
		"test": "eslint src --ext ts && tsc --noEmit",
		"compile": "tsc -p ./",
		"test-compile": "tsc -p ./",
		"pretest": "npm run compile",
		"test-old": "node ./out/test/runTest.js",
		"watch": "tsc -watch -p ./",
		"build-docs": "octave --no-gui --quiet scripts/build-docs.m && node scripts/build-markdown.js",
		"build-markdown": "node scripts/build-markdown.js"
	},
	"devDependencies": {
		"@types/glob": "^8.0.0",
		"@types/mocha": "^9.1.1",
		"@types/node": "^16.11.58",
		"@types/vscode": "^1.60.0",
		"@typescript-eslint/eslint-plugin": "^5.36.2",
		"@typescript-eslint/parser": "^5.36.2",
		"@vscode/test-electron": "^2.5.2",
		"esbuild": "^0.15.7",
		"eslint": "^8.23.1",
		"glob": "^8.0.3",
		"log-symbols": "^5.1.0",
		"mkdirp": "^1.0.4",
		"mocha": "^12.0.0",
		"object-inspect": "^1.12.2",
		"path-parse": "^1.0.7",
		"prettier": "^2.7.1",
		"side-channel": "^1.0.4",
		"sprintf-js": "^1.1.2",
		"turndown": "^7.2.0",
		"typescript": "^4.8.3"
	},
	"dependencies": {
		"ansi-colors": "^4.1.3",
		"camelcase": "^7.0.0",
		"diff": "^5.2.2",
		"es-abstract": "^1.20.2",
		"es-to-primitive": "^1.2.1",
		"growl": "^1.10.5",
		"http-proxy-agent": "^7.0.2",
		"https-proxy-agent": "^5.0.1",
		"once": "^1.4.0",
		"rimraf": "^3.0.2",
		"semver": "^7.5.2",
		"set-blocking": "^2.0.0",
		"types": "^0.1.1"
	}
}
